{
  // Configurazione Cloudflare Workers: gioco statico + server delle stanze
  "name": "cronache-di-aurora",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  // pubblica il gioco all'indirizzo <nome>.<tuo-sottodominio>.workers.dev
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // "new_sqlite_classes": richiesto dal piano gratuito di Cloudflare
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
